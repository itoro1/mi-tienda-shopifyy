<style>
.it-cf{background:var(--it-bg)}
.it-cf__head{text-align:center;max-width:560px;margin:0 auto 40px}
.it-cf__eyebrow{
  display:inline-flex;align-items:center;gap:8px;justify-content:center;
  font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
  color:var(--it-muted,#636360);margin-bottom:12px;
}
.it-cf__eyebrow::before,.it-cf__eyebrow::after{
  content:'';flex:1;height:1px;background:var(--it-border,rgba(0,0,0,.09));
  width:28px;
}
.it-cf__title{
  font-size:clamp(22px,3vw,30px);font-weight:700;
  color:var(--it-text,#0a0a0a);letter-spacing:-0.02em;
  line-height:1.2;margin:0 0 10px;
}
[data-theme="dark"] .it-cf__title{color:#ede9e2}
.it-cf__subtitle{
  font-size:14px;color:var(--it-muted,#636360);
  line-height:1.65;margin:0;
}
.it-cf__grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
  position:relative;
}
.it-cf__grid::before{
  content:'';
  position:absolute;
  top:52px;left:calc(12.5% + 8px);right:calc(12.5% + 8px);
  height:1px;
  background:linear-gradient(90deg,var(--it-accent,#d4af37),rgba(212,175,55,.2));
  z-index:0;
  pointer-events:none;
}
@media(max-width:768px){.it-cf__grid::before{display:none}}
.it-cf__card{
  background:var(--it-surface,#fff);
  border:0.5px solid var(--it-border,rgba(0,0,0,.09));
  border-radius:16px;
  padding:24px 20px;
  text-align:center;
  position:relative;
  transition:border-color .2s,transform .2s,box-shadow .2s;
  display:flex;
  flex-direction:column;
  align-items:center;
  text-decoration:none;
  color:inherit;
  z-index:1;
}
.it-cf__card:hover{
  border-color:rgba(212,175,55,.35);
  transform:translateY(-3px);
  box-shadow:0 8px 28px rgba(212,175,55,.10);
}
[data-theme="dark"] .it-cf__card{background:rgba(255,255,255,.03)}
[data-theme="dark"] .it-cf__card:hover{border-color:rgba(212,175,55,.28);box-shadow:0 8px 28px rgba(0,0,0,.3)}
.it-cf__num{
  position:absolute;top:14px;right:14px;
  font-size:10.5px;font-weight:700;
  color:var(--it-accent,#d4af37);
  letter-spacing:.06em;
  background:rgba(212,175,55,.10);
  border:0.5px solid rgba(212,175,55,.22);
  border-radius:20px;
  padding:2px 8px;
}
.it-cf__icon{
  width:56px;height:56px;border-radius:50%;
  background:rgba(212,175,55,.08);
  border:0.5px solid rgba(212,175,55,.22);
  display:flex;align-items:center;justify-content:center;
  margin-bottom:16px;
  transition:background .2s;
}
.it-cf__icon svg{
  width:24px;height:24px;
  stroke:var(--it-accent,#d4af37);
  fill:none;
  stroke-width:1.8;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.it-cf__card:hover .it-cf__icon{background:rgba(212,175,55,.14)}
.it-cf__step-title{
  font-size:15px;font-weight:700;
  color:var(--it-text,#0a0a0a);
  margin:0 0 8px;line-height:1.25;
}
[data-theme="dark"] .it-cf__step-title{color:#ede9e2}
.it-cf__step-text{
  font-size:12.5px;color:var(--it-muted,#636360);
  line-height:1.65;margin:0 0 14px;flex:1;
}
.it-cf__step-cta{
  font-size:12px;font-weight:600;
  color:var(--it-muted,#636360);
  transition:color .15s;
}
.it-cf__card:hover .it-cf__step-cta{color:var(--it-accent,#d4af37)}
.it-cf__footer{
  text-align:center;margin-top:36px;
}
.it-cf__footer-btn{
  display:inline-flex;align-items:center;gap:8px;
  height:52px;padding:0 32px;
  background:var(--it-text,#0a0a0a);color:#fff;
  border-radius:12px;text-decoration:none;
  font-size:14px;font-weight:700;letter-spacing:.02em;
  transition:opacity .2s,transform .15s;white-space:nowrap;
}
.it-cf__footer-btn:hover{opacity:.84;color:#fff;transform:translateY(-1px)}
.it-cf__footer-note{
  font-size:11.5px;color:var(--it-hint,rgba(0,0,0,.35));margin-top:12px;
}
[data-theme="dark"] .it-cf__footer-btn{background:#ede9e2;color:#0a0a0a}
[data-theme="dark"] .it-cf__footer-note{color:rgba(255,255,255,.3)}
@media(max-width:768px){
  .it-cf__grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:480px){
  .it-cf__grid{grid-template-columns:1fr}
}
</style>

<div class="it-section it-cf">
  <div class="it-section-inner">
    <div class="it-cf__head">
      <p class="it-cf__eyebrow">{{ section.settings.eyebrow | default: 'Proceso' }}</p>
      <h2 class="it-cf__title">{{ section.settings.title | default: 'Compra en 4 pasos' }}</h2>
      <p class="it-cf__subtitle">{{ section.settings.subtitle | default: 'Desde que eliges hasta que lo tienes en casa.' }}</p>
    </div>

    <div class="it-cf__grid">

      <a href="/collections/todos-los-iphones" class="it-cf__card">
        <span class="it-cf__num">01</span>
        <div class="it-cf__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
        </div>
        <h3 class="it-cf__step-title">Elige tu iPhone</h3>
        <p class="it-cf__step-text">Navega por nuestro cat&aacute;logo y elige el modelo, color y almacenamiento que quieres.</p>
        <span class="it-cf__step-cta">Ver cat&aacute;logo &rarr;</span>
      </a>

      <a href="/collections/todos-los-iphones" class="it-cf__card">
        <span class="it-cf__num">02</span>
        <div class="it-cf__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
        </div>
        <h3 class="it-cf__step-title">Reserva por 50 &euro;</h3>
        <p class="it-cf__step-text">Paga solo 50 &euro; para asegurar tu plaza. Este importe se descuenta del precio final.</p>
        <span class="it-cf__step-cta">Reservar ahora &rarr;</span>
      </a>

      <a href="https://wa.me/34624150603?text=Hola%2C+tengo+una+reserva+de+ITorostore" target="_blank" rel="noopener noreferrer" class="it-cf__card">
        <span class="it-cf__num">03</span>
        <div class="it-cf__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <h3 class="it-cf__step-title">Te contactamos en 24h</h3>
        <p class="it-cf__step-text">Te escribimos por WhatsApp para confirmar todos los detalles y el plazo de entrega.</p>
        <span class="it-cf__step-cta">Escribirnos &rarr;</span>
      </a>

      <a href="/pages/politica-de-envios" class="it-cf__card">
        <span class="it-cf__num">04</span>
        <div class="it-cf__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </div>
        <h3 class="it-cf__step-title">Recibe tu iPhone</h3>
        <p class="it-cf__step-text">Tras el pago del resto, enviamos tu iPhone en 3&ndash;5 d&iacute;as h&aacute;biles con Correos. Seguimiento incluido.</p>
        <span class="it-cf__step-cta">Info de env&iacute;os &rarr;</span>
      </a>

    </div>

    <div class="it-cf__footer">
      <a href="/collections/todos-los-iphones" class="it-cf__footer-btn">
        Elegir mi iPhone y reservarlo
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <p class="it-cf__footer-note">Los 50 &euro; se descuentan del precio final &middot; Cancelaci&oacute;n gratuita</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cómo funciona",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Proceso" },
    { "type": "text", "id": "title", "label": "Título", "default": "Compra en 4 pasos" },
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo", "default": "Desde que eliges hasta que lo tienes en casa." }
  ],
  "presets": [{ "name": "Cómo funciona" }]
}
{% endschema %}
