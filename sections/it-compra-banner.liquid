        <div class="itcb-price-row">
          <span class="itcb-p-model">iPhone 15 Pro</span>
          <span class="itcb-p-sep"></span>
          <span class="itcb-p-val">hasta 580 &euro;</span>
        </div>
        <div class="itcb-price-row itcb-price-row--hi">
