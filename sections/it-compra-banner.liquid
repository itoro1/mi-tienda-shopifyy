            <p class="itcb-check-t">Pago 100% seguro</p>
            <p class="itcb-check-d">Sin intermediarios</p>
          </div>
        </div>
      </div>

      <div class="itcb-prices">
        <p class="itcb-prices-title">Lo que pagamos por tu iPhone:</p>
