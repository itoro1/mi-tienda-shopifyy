          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
.itcb{font-family:inherit;border-top:3px solid #15803d}
.itcb-wrap{max-width:1100px;margin:0 auto;padding:52px 48px;display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start;background:#ffffff}
.itcb-l{background:#ffffff}
.itcb-tag{display:inline-flex;align-items:center;gap:7px;font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#166534!important;background:#f0fdf4!important;border:1.5px solid #86efac!important;padding:5px 14px;border-radius:20px;margin-bottom:16px}
.itcb-tag svg{flex-shrink:0;stroke:#166534}
.itcb-title{font-size:36px;font-weight:700;letter-spacing:-0.03em;line-height:1.1;color:#0a0a0a!important;margin:0 0 14px}
.itcb-desc{font-size:15px;color:#374151!important;line-height:1.7;margin:0 0 22px}
.itcb-desc strong{color:#15803d!important;font-weight:700}
.itcb-checks{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:22px}
.itcb-check{display:flex;align-items:flex-start;gap:10px;padding:12px;background:#f9fafb!important;border:1px solid #e5e7eb!important;border-radius:10px}
.itcb-check-ico{flex-shrink:0;width:38px;height:38px;background:#ffffff!important;border:1px solid #e5e7eb!important;border-radius:50%;display:flex;align-items:center;justify-content:center}
.itcb-check-ico svg{width:18px;height:18px}
.itcb-check-t{font-size:12px;font-weight:700;color:#111827!important;margin:0 0 2px;line-height:1.3}
.itcb-check-d{font-size:11px;color:#6b7280!important;margin:0;line-height:1.3}
.itcb-prices{background:#f9fafb!important;border:1px solid #e5e7eb!important;border-radius:12px;padding:14px 16px;margin-bottom:24px}
.itcb-prices-title{font-size:11px;font-weight:600;color:#6b7280!important;text-transform:uppercase;letter-spacing:1px;margin:0 0 10px}
.itcb-price-row{display:flex;align-items:center;gap:8px;font-size:13px;padding:5px 0;border-bottom:1px solid #f3f4f6}
.itcb-price-row:last-child{border-bottom:none}
.itcb-p-model{color:#6b7280!important;min-width:130px;font-weight:400}
.itcb-price-row--hi .itcb-p-model{color:#111827!important;font-weight:600}
.itcb-p-sep{flex:1;height:1px;background:#e5e7eb}
.itcb-p-val{color:#374151!important;font-weight:500;white-space:nowrap}
.itcb-p-hi{color:#15803d!important;font-weight:700!important;font-size:14px!important}
.itcb-wa{display:inline-flex;align-items:center;gap:10px;padding:14px 24px;background:#16a34a!important;color:#ffffff!important;border-radius:12px;text-decoration:none;font-weight:700;font-size:14px;min-height:52px;margin-bottom:10px;transition:background .2s}
.itcb-wa:hover{background:#15803d!important;color:#ffffff!important}
.itcb-note{font-size:11px;color:#9ca3af!important;margin:0}
.itcb-r{background:#0f172a!important;border-radius:16px;overflow:hidden;border:1px solid #1e293b!important}
.itcb-stats{display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid #1e293b}
.itcb-stat{padding:20px 16px;text-align:center;border-right:1px solid #1e293b;background:#0f172a!important}
.itcb-stat:nth-child(even){border-right:none}
.itcb-stat:nth-child(n+3){border-top:1px solid #1e293b}
.itcb-stat-g{background:#052e16!important}
.itcb-stat-n{display:block;font-size:24px;font-weight:700;color:#f8fafc!important;line-height:1;margin-bottom:5px;letter-spacing:-0.02em}
.itcb-stat-g .itcb-stat-n{color:#4ade80!important}
.itcb-stat-l{display:block;font-size:11px;color:#94a3b8!important;line-height:1.3}
.itcb-stat-g .itcb-stat-l{color:#86efac!important}
.itcb-steps{padding:20px;display:flex;flex-direction:column;gap:14px;background:#0f172a!important}
.itcb-step{display:flex;align-items:flex-start;gap:12px}
.itcb-step-n{width:30px;height:30px;border-radius:50%;background:#1e293b!important;border:1px solid #334155!important;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#e2e8f0!important;flex-shrink:0}
.itcb-step-t{font-size:13px;font-weight:600;color:#f1f5f9!important;margin:0 0 2px;line-height:1.3}
.itcb-step-t strong{color:#4ade80!important}
.itcb-step-d{font-size:11px;color:#94a3b8!important;margin:0;line-height:1.4}
[data-theme="dark"] .itcb-wrap{background:#0d0d0b!important}
[data-theme="dark"] .itcb-l{background:transparent!important}
[data-theme="dark"] .itcb-tag{color:#d4af37!important;background:rgba(212,175,55,.1)!important;border-color:rgba(212,175,55,.35)!important}
[data-theme="dark"] .itcb-tag svg{stroke:#d4af37}
[data-theme="dark"] .itcb-title{color:#f0ece4!important}
[data-theme="dark"] .itcb-desc{color:#d1d5db!important}
[data-theme="dark"] .itcb-desc strong{color:#4ade80!important}
[data-theme="dark"] .itcb-check{background:#18181c!important;border-color:rgba(255,255,255,.08)!important}
[data-theme="dark"] .itcb-check-ico{background:#0d0d0b!important;border-color:rgba(255,255,255,.1)!important}
[data-theme="dark"] .itcb-check-ico svg{stroke:#d4af37}
[data-theme="dark"] .itcb-check-t{color:#f0ece4!important}
[data-theme="dark"] .itcb-check-d{color:#9ca3af!important}
[data-theme="dark"] .itcb-prices{background:#18181c!important;border-color:rgba(255,255,255,.08)!important}
[data-theme="dark"] .itcb-prices-title{color:#9ca3af!important}
[data-theme="dark"] .itcb-p-model{color:#9ca3af!important}
[data-theme="dark"] .itcb-price-row--hi .itcb-p-model{color:#f0ece4!important}
[data-theme="dark"] .itcb-p-sep{background:rgba(255,255,255,.1)}
[data-theme="dark"] .itcb-p-val{color:#e2e8f0!important}
[data-theme="dark"] .itcb-p-hi{color:#d4af37!important}
[data-theme="dark"] .itcb-price-row{border-color:rgba(255,255,255,.06)}
[data-theme="dark"] .itcb-note{color:#6b7280!important}
@media(max-width:900px){.itcb-wrap{grid-template-columns:1fr;gap:28px;padding:36px 20px}.itcb-title{font-size:26px}.itcb-stats{grid-template-columns:repeat(4,1fr)}.itcb-stat:nth-child(n+3){border-top:none}.itcb-stat:nth-child(2){border-right:1px solid #1e293b}.itcb-stat:nth-child(4){border-right:none}}
@media(max-width:600px){.itcb-checks{grid-template-columns:1fr}.itcb-stats{grid-template-columns:1fr 1fr}.itcb-stat:nth-child(2){border-right:none}.itcb-stat:nth-child(n+3){border-top:1px solid #1e293b}.itcb-wa{width:100%;justify-content:center}}
</style>

