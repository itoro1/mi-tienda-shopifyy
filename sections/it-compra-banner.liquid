          <div class="itcb-step-n">3</div>
          <div class="itcb-step-txt">
            <p class="itcb-step-t">Recogida <strong>gratuita</strong> a domicilio</p>
            <p class="itcb-step-d">En toda Espa&ntilde;a &mdash; sin costes ocultos</p>
          </div>
        </div>
        <div class="itcb-step">
          <div class="itcb-step-n">4</div>
          <div class="itcb-step-txt">
            <p class="itcb-step-t">Cobras al instante</p>
