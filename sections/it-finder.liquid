<style>
.it-finder{background:var(--it-bg)}
.it-finder-header{text-align:center;margin-bottom:22px}
.it-finder-title{font-size:clamp(20px,3vw,30px);font-weight:300;letter-spacing:-.02em;color:var(--it-text);margin:4px 0 6px}
.it-finder-sub{font-size:13px;color:var(--it-muted);margin:0}
.it-finder-row-label{font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--it-muted);margin:0 0 10px;padding:0 2px}
.it-finder-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
.it-fcard{display:flex;flex-direction:column;align-items:center;text-decoration:none;color:inherit;padding:10px 6px 12px;border:0.5px solid var(--it-border);border-radius:var(--it-radius-lg);background:var(--it-surface);transition:all .2s;text-align:center;gap:5px;cursor:pointer}
.it-fcard:hover{border-color:var(--it-border2);transform:translateY(-3px);box-shadow:0 6px 18px rgba(0,0,0,.09)}
.it-fcard--pro{border-color:rgba(180,140,30,.3);background:linear-gradient(to bottom,rgba(212,175,55,.04),var(--it-surface))}
.it-fcard--new{border-color:rgba(21,128,61,.25);background:linear-gradient(to bottom,rgba(21,128,61,.04),var(--it-surface))}
[data-theme=dark] .it-fcard--new{border-color:rgba(212,175,55,.2)}
.it-fcard--pro.it-fcard--new{border-color:var(--it-accent)!important;background:linear-gradient(to bottom,rgba(212,175,55,.08),var(--it-surface))!important}
.it-fcard--top{border-color:var(--it-accent)!important;border-width:1.5px!important;background:linear-gradient(to bottom,rgba(212,175,55,.1),var(--it-surface))!important}
.it-fcard-wrap{position:relative;display:flex;align-items:flex-end;justify-content:center;width:100%}
.it-fcard-img{width:100%;aspect-ratio:1;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:6px;background:var(--it-surface2)}
.it-fcard-img img{width:100%;height:100%;object-fit:contain;transition:transform .3s}
.it-fcard:hover .it-fcard-img img{transform:scale(1.07)}
.it-fcard-hot{position:absolute;top:0;right:0;font-size:8px;font-weight:700;padding:2px 6px;border-radius:20px;background:#15803d;color:#fff;z-index:2}
.it-fcard-hot--top{background:var(--it-accent);color:#0d0d0b}
.it-fcard-name{font-size:11px;font-weight:500;color:var(--it-text);margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%}
.it-fcard-price{font-size:11px;font-weight:700;color:var(--it-text);margin:0}
[data-theme=dark] .it-fcard--top .it-fcard-price{color:var(--it-accent)}
.it-fcard-badge{font-size:8px;font-weight:600;padding:2px 6px;border-radius:20px}
.it-fcard-badge--used{background:rgba(59,130,246,.1);color:#1d4ed8;border:.5px solid rgba(59,130,246,.2)}
[data-theme=dark] .it-fcard-badge--used{background:rgba(212,175,55,.08);color:var(--it-accent);border-color:rgba(212,175,55,.2)}
.it-fcard-badge--new{background:rgba(21,128,61,.1);color:#15803d;border:.5px solid rgba(21,128,61,.25)}
[data-theme=dark] .it-fcard-badge--new{background:rgba(212,175,55,.1);color:var(--it-accent);border-color:rgba(212,175,55,.25)}
@media(max-width:600px){
  .it-finder-grid{grid-template-columns:repeat(5,1fr);gap:6px}
  .it-fcard{padding:7px 3px 9px;gap:4px}
  .it-fcard-name{font-size:9px}
  .it-fcard-price{font-size:9px}
  .it-fcard-badge{font-size:7px;padding:2px 5px}
  .it-fcard-hot{font-size:7px;padding:1px 5px}
  .it-finder-title{font-size:18px}
  .it-finder-row-label{font-size:9px;letter-spacing:1px}
  .it-finder-header{margin-bottom:14px}
}
</style>

{% schema %}
{
  "name":"Finder iPhones",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Elige tu modelo"},
    {"type":"text","id":"title","label":"Titulo","default":"Descubre tu iPhone ideal"},
    {"type":"textarea","id":"subtitle","label":"Subtitulo","default":"Toca el modelo que te interesa"}
  ],
  "presets":[{"name":"Finder iPhones"}]
}
{% endschema %}
