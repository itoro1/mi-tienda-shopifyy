.it-footer-copy { font-size: 11px; color: var(--it-hint); margin: 0; }
.it-footer-payments { display: flex; align-items: center; gap: 6px; }
.it-payment-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 600; letter-spacing: .04em; padding: 4px 9px; border-radius: 5px; line-height: 1; }
.it-payment-badge--visa { background: #1a1f71; color: #fff; font-style: italic; }
.it-payment-badge--mc { background: #f5f5f5; color: #333; border: 0.5px solid rgba(0,0,0,.12); }
[data-theme="dark"] .it-payment-badge--mc { background: #2a2a2e; color: #ccc; border-color: rgba(255,255,255,.1); }
.it-payment-badge--pp { background: #003087; color: #fff; }
.it-payment-badge--bz { background: #00bfa5; color: #fff; }
@media (max-width: 900px) { .it-footer-inner { grid-template-columns: 1fr 1fr; padding: 32px 20px 24px; gap: 24px; } .it-footer-bottom-inner { padding: 14px 20px; } }
@media (max-width: 480px) { .it-footer-inner { grid-template-columns: 1fr; } }
