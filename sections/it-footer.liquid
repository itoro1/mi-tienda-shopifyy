.it-footer-link { display: block; font-size: 13px; color: var(--it-muted); text-decoration: none; margin-bottom: 8px; transition: color 0.2s; line-height: 1.4; }
.it-footer-link:hover { color: var(--it-text); }
.it-footer-link--whatsapp:hover { color: #25d366; }
