{%- if section.settings.show_section -%}
<section class="it-section it-google-reviews">
  <div class="it-greviews-header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="it-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="it-section-title">{{ section.settings.title }}</h2>

    <div class="it-gbadge">
      <span class="it-gbadge__logo" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 48 48">
          <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
          <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
          <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/>
          <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
        </svg>
      </span>
      <span class="it-gbadge__stars" aria-hidden="true">
        {%- for i in (1..5) -%}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#fbbc05"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        {%- endfor -%}
      </span>
      <span class="it-gbadge__score">{{ section.settings.rating }}</span>
      <span class="it-gbadge__count">&middot; {{ section.settings.review_count }} en Google</span>
    </div>
  </div>

  {%- assign has_reviews = false -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.name != blank -%}{%- assign has_reviews = true -%}{%- endif -%}
  {%- endfor -%}

  {%- if has_reviews -%}
    <div class="it-greviews-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' and block.settings.name != blank -%}
          <article class="it-greview-card" {{ block.shopify_attributes }}>
            <div class="it-greview-top">
              <div class="it-greview-who">
                {%- if block.settings.photo != blank -%}
                  <img src="{{ block.settings.photo }}" alt="{{ block.settings.name | escape }}" class="it-greview-avatar" width="40" height="40" loading="lazy">
                {%- else -%}
                  <span class="it-greview-initial" aria-hidden="true">{{ block.settings.name | slice: 0 | upcase }}</span>
                {%- endif -%}
                <div>
                  <p class="it-greview-name">{{ block.settings.name }}</p>
                  {%- if block.settings.date != blank -%}
                    <p class="it-greview-date">{{ block.settings.date }}</p>
                  {%- endif -%}
                </div>
              </div>
              <span class="it-greview-g" aria-label="Rese&ntilde;a de Google">
                <svg width="16" height="16" viewBox="0 0 48 48" aria-hidden="true">
                  <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
                  <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
                  <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/>
                  <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
                </svg>
              </span>
            </div>

            <div class="it-greview-stars" aria-label="{{ block.settings.stars }} de 5 estrellas">
              {%- assign n = block.settings.stars | default: 5 -%}
              {%- for i in (1..5) -%}
                {%- if i <= n -%}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="#fbbc05" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- else -%}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="#dadce0" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if block.settings.text != blank -%}
              <p class="it-greview-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="it-greviews-cta">
    {%- if section.settings.review_url != blank -%}
      <a href="{{ section.settings.review_url }}" target="_blank" rel="noopener" class="it-btn-primary it-gcta">
        {{ section.settings.cta_text | default: 'Dejar mi rese&ntilde;a en Google' }}
      </a>
    {%- endif -%}
    {%- if section.settings.profile_url != blank -%}
      <a href="{{ section.settings.profile_url }}" target="_blank" rel="noopener" class="it-btn-secondary">
        Ver en Google &rarr;
      </a>
    {%- endif -%}
  </div>
</section>

<style>
.it-google-reviews{ text-align:center }
.it-greviews-header{ margin-bottom:24px }
.it-gbadge{
  display:inline-flex; align-items:center; gap:8px; flex-wrap:wrap; justify-content:center;
  margin-top:12px; padding:8px 16px; border-radius:999px;
  background:var(--it-surface2,#f5f5f7); border:0.5px solid var(--it-border,rgba(0,0,0,.08));
}
.it-gbadge__logo{ display:inline-flex; line-height:0 }
.it-gbadge__stars{ display:inline-flex; gap:1px; line-height:0 }
.it-gbadge__score{ font-weight:700; font-size:14px; color:var(--it-text) }
.it-gbadge__count{ font-size:13px; color:var(--it-muted) }

.it-greviews-grid{
  display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:16px; margin:24px auto 0; max-width:1100px; text-align:left;
}
.it-greview-card{
  background:var(--it-surface,#fff); border:0.5px solid var(--it-border,rgba(0,0,0,.08));
  border-radius:var(--it-radius-lg,12px); padding:18px 20px;
  transition:transform .18s, box-shadow .2s;
}
.it-greview-card:hover{ transform:translateY(-2px); box-shadow:0 8px 24px rgba(0,0,0,.08) }
.it-greview-top{ display:flex; align-items:center; justify-content:space-between; gap:10px }
.it-greview-who{ display:flex; align-items:center; gap:10px; min-width:0 }
.it-greview-avatar{ width:40px; height:40px; border-radius:50%; object-fit:cover; flex:0 0 auto }
.it-greview-initial{
  width:40px; height:40px; border-radius:50%; flex:0 0 auto;
  display:inline-flex; align-items:center; justify-content:center;
  background:linear-gradient(135deg,#4285F4,#34A853); color:#fff; font-weight:700; font-size:16px;
}
.it-greview-name{ margin:0; font-size:14px; font-weight:600; color:var(--it-text) }
.it-greview-date{ margin:2px 0 0; font-size:12px; color:var(--it-hint,#8a8a8e) }
.it-greview-g{ line-height:0; flex:0 0 auto }
.it-greview-stars{ display:flex; gap:1px; margin:12px 0 8px; line-height:0 }
.it-greview-text{ margin:0; font-size:14px; line-height:1.6; color:var(--it-muted) }

.it-greviews-cta{ display:flex; gap:12px; justify-content:center; flex-wrap:wrap; margin-top:26px }
.it-gcta{ text-decoration:none }
[data-theme="dark"] .it-greview-card{ background:#17171a; border-color:rgba(255,255,255,.1) }
[data-theme="dark"] .it-gbadge{ background:rgba(255,255,255,.06); border-color:rgba(255,255,255,.1) }
@media(max-width:600px){ .it-greviews-grid{ grid-template-columns:1fr } }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Valoraciones Google",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Mostrar sección", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Valorados en Google" },
    { "type": "text", "id": "title", "label": "Título", "default": "Reseñas verificadas en Google" },
    { "type": "text", "id": "rating", "label": "Nota media", "default": "5,0" },
    { "type": "text", "id": "review_count", "label": "Nº de reseñas", "default": "1 reseña" },
    { "type": "text", "id": "cta_text", "label": "Texto del botón", "default": "Dejar mi reseña en Google" },
    { "type": "url", "id": "review_url", "label": "Enlace para dejar reseña" },
    { "type": "url", "id": "profile_url", "label": "Enlace al perfil de Google" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre del cliente" },
        { "type": "text", "id": "date", "label": "Fecha (ej: hace 2 semanas)" },
        { "type": "range", "id": "stars", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Texto de la reseña" },
        { "type": "text", "id": "photo", "label": "URL foto de perfil (opcional)" }
      ]
    }
  ],
  "presets": [{ "name": "Valoraciones Google" }]
}
{% endschema %}
