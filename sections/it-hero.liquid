<section class="it-section it-hero">
  <div class="it-hero-text">
    {%- if section.settings.eyebrow != blank -%}
      <p class="it-hero-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="it-hero-title">{{ section.settings.title }}</h1>
    <p class="it-hero-desc">{{ section.settings.description }}</p>
    <div class="it-hero-trust-pills">
      <span class="it-pill">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Sellado de f&aacute;brica
      </span>
      <span class="it-pill">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Garant&iacute;a 3 a&ntilde;os
      </span>
      <span class="it-pill">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        Env&iacute;o 24h gratis
      </span>
      <span class="it-pill">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Pago seguro
      </span>
    </div>
    <div class="it-hero-actions">
      {%- if section.settings.btn1_label != blank -%}
        <a href="{{ section.settings.btn1_url }}" class="it-btn-primary">{{ section.settings.btn1_label }}</a>
      {%- endif -%}
      {%- if section.settings.btn2_label != blank -%}
        <a href="{{ section.settings.btn2_url }}" class="it-btn-secondary">{{ section.settings.btn2_label }}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="it-hero-visual">
    {%- if section.settings.hero_image != blank -%}
      <img src="{{ section.settings.hero_image | image_url: width: 600 }}" alt="{{ section.settings.title | escape }}" style="width:100%;height:100%;object-fit:cover;" />
    {%- else -%}
      <svg width="110" height="220" viewBox="0 0 60 120" fill="none">
        <rect x="2" y="2" width="56" height="116" rx="12" fill="#e0e0dc" stroke="#c8c8c4" stroke-width="1"/>
        <rect x="8" y="8" width="44" height="104" rx="8" fill="#d0d0cc"/>
        <rect x="20" y="12" width="20" height="5" rx="2.5" fill="#b8b8b4"/>
        <rect x="12" y="22" width="36" height="60" rx="4" fill="#c4c4c0"/>
      </svg>
    {%- endif -%}
  </div>
</section>

{%- render 'it-trustbar' -%}

{% schema %}
{
  "name": "Hero principal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño arriba", "default": "Nuevo · iPhone 17 Pro Max" },
    { "type": "text", "id": "title", "label": "Título principal", "default": "Tecnología que marca la diferencia." },
    { "type": "textarea", "id": "description", "label": "Descripción", "default": "Los últimos modelos de iPhone sellados de fábrica con garantía oficial Apple 3 años. Envío gratis en 24 horas a toda España." },
    { "type": "image_picker", "id": "hero_image", "label": "Imagen (opcional)" },
    { "type": "header", "content": "Botón principal" },
    { "type": "text", "id": "btn1_label", "label": "Texto", "default": "Ver iPhones →" },
    { "type": "url", "id": "btn1_url", "label": "Enlace" },
    { "type": "header", "content": "Botón secundario" },
    { "type": "text", "id": "btn2_label", "label": "Texto", "default": "Ver cargadores" },
    { "type": "url", "id": "btn2_url", "label": "Enlace" }
  ],
  "presets": [{ "name": "Hero principal" }]
}
{% endschema %}
