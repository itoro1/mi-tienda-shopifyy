<style>
/* Financiación */
.it-fin-section{background:var(--it-surface);border-top:0.5px solid var(--it-border)}
.it-fin-wrap{display:flex;gap:40px;align-items:flex-start;flex-wrap:wrap}
.it-fin-left{flex:1;min-width:220px}
.it-fin-title{font-size:20px;font-weight:400;color:var(--it-text);margin:4px 0 8px;letter-spacing:-.01em}
.it-fin-sub{font-size:13px;color:var(--it-muted);line-height:1.65;margin:0 0 16px}
.it-fin-wa{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;background:#25d366;color:#fff;border-radius:8px;text-decoration:none;font-size:13px;font-weight:500;transition:opacity .2s;min-height:40px}
.it-fin-wa:hover{opacity:.85}
.it-fin-cards{display:flex;gap:10px;flex-wrap:wrap;flex:1;justify-content:flex-end}
.it-fin-card{background:var(--it-bg);border:0.5px solid var(--it-border);border-radius:var(--it-radius-lg);padding:16px 20px;text-align:center;flex:1;min-width:100px;max-width:140px}
.it-fin-months{font-size:10px;color:var(--it-hint);margin:0 0 6px;text-transform:uppercase;letter-spacing:.5px}
.it-fin-amount{font-size:24px;font-weight:500;color:var(--it-text);margin:0 0 3px;letter-spacing:-.02em}
[data-theme=dark] .it-fin-amount{color:var(--it-accent)}
.it-fin-suffix{font-size:11px;color:var(--it-hint);margin:0}
@media(max-width:768px){.it-fin-wrap{flex-direction:column;gap:20px}.it-fin-cards{justify-content:stretch;width:100%}.it-fin-card{max-width:none}}

/* Relacionados */
.it-related-section{background:var(--it-bg)}
.it-related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px}
.it-rel-card{background:var(--it-surface);border:0.5px solid var(--it-border);border-radius:var(--it-radius-lg);overflow:hidden;text-decoration:none;color:inherit;display:block;transition:border-color .2s,transform .2s}
.it-rel-card:hover{border-color:var(--it-border2);transform:translateY(-2px)}
.it-rel-img{width:100%;aspect-ratio:1;object-fit:contain;padding:12px;background:var(--it-surface2)}
.it-rel-body{padding:10px 12px}
.it-rel-name{font-size:12px;font-weight:500;color:var(--it-text);margin:0 0 4px;line-height:1.3}
.it-rel-price{font-size:14px;font-weight:500;color:var(--it-text);margin:0}
[data-theme=dark] .it-rel-price{color:var(--it-accent)}
.it-rel-old{font-size:11px;color:var(--it-hint);text-decoration:line-through;margin-left:5px;font-weight:400}
</style>

<script>
(function(){
  /* ----- Mapa de stock por variante (Comprar / Reservar) ----- */
  var itStockMap = {
    {%- for v in product.variants -%}
      "{{ v.id }}": {% if v.inventory_management == 'shopify' and v.inventory_quantity <= 0 %}"reservar"{% else %}"comprar"{% endif %}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  };

  function currentVariantId(){
    var input = document.querySelector('product-info input[name="id"], .product-variant-id, form[data-type="add-to-cart-form"] input[name="id"]');
    return input ? input.value : null;
  }

  function applyLabel(){
    var btn = document.querySelector('.product-form__submit');
    if(!btn) return;
    var span = btn.querySelector('span');
    if(!span) return;
    if(btn.hasAttribute('disabled')) return;
    var vid = currentVariantId();
    var desired = (vid && itStockMap[vid] === 'reservar') ? 'Reservar ahora' : 'Comprar ahora';
    if(span.textContent.trim() !== desired){
      span.textContent = desired;
    }
  }

  function init(){
    applyLabel();
    var pi = document.querySelector('product-info');
    if(pi && window.MutationObserver){
      var mo = new MutationObserver(function(){ applyLabel(); });
      mo.observe(pi, {subtree:true, childList:true, characterData:true, attributes:true, attributeFilter:['value','disabled']});
    }
  }
  if(document.readyState !== 'loading'){ init(); }
  else { document.addEventListener('DOMContentLoaded', init); }

  /* ----- Financiación ----- */
  var price={{ product.price }};
  if(price>0){
    var eur=price/100;
    var months=[6,12,18];
    var html=months.map(function(m){
      var mo=Math.ceil(eur/m);
      return '<div class="it-fin-card"><p class="it-fin-months">'+m+' meses</p><p class="it-fin-amount">'+mo+'&euro;</p><p class="it-fin-suffix">/mes aprox.</p></div>';
    }).join('');
    var fc=document.getElementById('itFinCards');
    var fw=document.getElementById('itFinancingCalc');
    if(fc&&fw){fc.innerHTML=html;fw.style.display='block';}
  }

  /* ----- Relacionados ----- */
  var col='{{ product.collections.first.handle }}';
  if(col){
    fetch('/collections/'+col+'/products.json?limit=8')
      .then(function(r){return r.json();})
      .then(function(d){
        var others=(d.products||[]).filter(function(p){return p.id!={{ product.id }};}).slice(0,4);
        if(!others.length)return;
        var html=others.map(function(p){
          var img=p.images&&p.images[0]?p.images[0].src:'';
          var pv=p.variants&&p.variants[0]?p.variants[0]:{};
          var ps=pv.price?parseFloat(pv.price).toLocaleString('es-ES',{style:'currency',currency:'EUR',maximumFractionDigits:0}):'';
          var cp=pv.compare_at_price?parseFloat(pv.compare_at_price).toLocaleString('es-ES',{style:'currency',currency:'EUR',maximumFractionDigits:0}):'';
          return '<a class="it-rel-card" href="/products/'+p.handle+'">'
            +(img?'<img class="it-rel-img" src="'+img+'" alt="'+p.title+'" loading="lazy">':'')
            +'<div class="it-rel-body"><p class="it-rel-name">'+p.title+'</p>'
            +'<p class="it-rel-price">'+ps+(cp?'<span class="it-rel-old">'+cp+'</span>':'')+'</p></div></a>';
        }).join('');
        var rw=document.getElementById('itRelatedWrap');
        var rg=document.getElementById('itRelatedGrid');
        if(rw&&rg){rg.innerHTML=html;rw.style.display='block';}
      }).catch(function(){});
  }
})();
</script>

