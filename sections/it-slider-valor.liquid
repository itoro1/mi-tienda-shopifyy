<style>
.it-sv-wrap{
  background: var(--it-surface, #ffffff);
  border-top: 0.5px solid var(--it-border, #e5e7eb);
  border-bottom: 0.5px solid var(--it-border, #e5e7eb);
}
.it-sv-viewport{height:48px;overflow:hidden;position:relative;}
.it-sv-track{
  display:flex;flex-direction:column;
  will-change:transform;
  transition:transform 0.35s cubic-bezier(0.4,0,0.2,1);
}
.it-sv-row{
  height:48px;
  display:flex;align-items:center;gap:12px;
  padding:0 48px;flex-shrink:0;min-width:0;
}
.it-sv-ico2{
  flex-shrink:0;
  width:30px;height:30px;
  background: var(--it-surface2, #f5f5f7);
  border: 0.5px solid var(--it-border, #e5e7eb);
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
}
.it-sv-ico2 svg{
  width:14px;height:14px;
  stroke:var(--it-accent,#d4af37);fill:none;
  stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;
}
.it-sv-msg{
  font-size:13px;
  color: var(--it-text, #111110) !important;
  flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;
}
.it-sv-msg b{font-weight:600}
.it-sv-badge2{
  font-size:20px;font-weight:300;
  color: var(--it-text, #111110);
  flex-shrink:0;letter-spacing:-0.5px;
}
[data-theme=dark] .it-sv-badge2{ color: #d4af37; }
.it-sv-kl{font-size:11px;font-weight:700;padding:3px 9px;border-radius:5px;background:#ffb3c7;color:#17120e;flex-shrink:0}
.it-sv-sq{font-size:11px;font-weight:700;padding:3px 9px;border-radius:5px;background:#00a97f;color:#fff;flex-shrink:0}
.it-sv-btn2{
  display:inline-flex;align-items:center;padding:5px 13px;
  background: var(--it-text, #111110);
  color: var(--it-bg, #ffffff);
  border-radius:6px;text-decoration:none;
  font-size:12px;font-weight:500;flex-shrink:0;white-space:nowrap;min-height:30px;
}
.it-sv-pays2{display:flex;gap:4px;flex-shrink:0}
.it-sv-pays2 span{
  font-size:10px;font-weight:600;padding:2px 7px;
  border:0.5px solid var(--it-border2, #d1d5db);
  border-radius:4px;
  color: var(--it-muted, #6b7280);
  white-space:nowrap;
}
@media(max-width:640px){
  .it-sv-row{padding:0 14px;gap:8px}
  .it-sv-msg{font-size:12px}
  .it-sv-badge2{font-size:16px}
  .it-sv-ico2{width:26px;height:26px}
  .it-sv-ico2 svg{width:12px;height:12px}
}
</style>

<script>
(function(){
  var track=document.getElementById('itSvTrack2');
  if(!track)return;
  var rows=track.querySelectorAll('.it-sv-row');
  var total=rows.length;
  var rowH=48;
  var current=0;
  function goNext(){
    current=(current+1)%total;
    if(current===0){
      track.style.transition='none';
      track.style.transform='translateY(0px)';
      void track.offsetHeight;
      track.style.transition='transform 0.35s cubic-bezier(0.4,0,0.2,1)';
    } else {
      track.style.transform='translateY(-'+(current*rowH)+'px)';
    }
  }
  setInterval(goNext,3800);
})();
</script>

