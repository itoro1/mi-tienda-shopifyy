{%- assign p1 = all_products['iphone-17-pro'] -%}
{%- assign p2 = all_products['iphone-17-pro-max'] -%}

<style>
.it-urg{
  background:var(--it-surface);
  border-top:0.5px solid var(--it-border);
  border-bottom:0.5px solid var(--it-border);
}
[data-theme="dark"] .it-urg{
  border-color:rgba(255,255,255,.07);
}
.it-urg__inner{
  max-width:var(--page-width,1100px);margin:0 auto;
  padding:36px 24px;
  display:flex;gap:40px;align-items:center;flex-wrap:wrap;
}
.it-urg__left{flex:1;min-width:220px}
.it-urg__eyebrow{
  display:inline-flex;align-items:center;gap:7px;
  font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;
  color:#15803d;
  background:rgba(21,128,61,0.09);
  border:0.5px solid rgba(21,128,61,.22);
  padding:5px 12px;border-radius:20px;margin-bottom:14px;
}
.it-urg__eyebrow-dot{
  width:6px;height:6px;border-radius:50%;background:#22c55e;flex-shrink:0;
  animation:urg-pulse 1.8s ease-in-out infinite;
}
@keyframes urg-pulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(34,197,94,.4)}50%{opacity:.7;box-shadow:0 0 0 4px rgba(34,197,94,0)}}
[data-theme="dark"] .it-urg__eyebrow{color:var(--it-accent,#d4af37);background:rgba(212,175,55,.08);border-color:rgba(212,175,55,.20)}
[data-theme="dark"] .it-urg__eyebrow-dot{background:var(--it-accent,#d4af37);animation:none}
.it-urg__title{
  font-size:clamp(20px,3vw,26px);font-weight:700;
  color:var(--it-text,#0a0a0a);letter-spacing:-0.02em;
  line-height:1.2;margin:0 0 10px;
}
[data-theme="dark"] .it-urg__title{color:#ede9e2}
.it-urg__desc{
  font-size:13.5px;color:var(--it-muted,#636360);
  line-height:1.6;margin:0 0 22px;
}
.it-urg__cta{
  display:inline-flex;align-items:center;gap:8px;
  height:46px;padding:0 24px;
  background:var(--it-text,#0a0a0a);color:#fff;
  border-radius:10px;text-decoration:none;
  font-size:13.5px;font-weight:700;letter-spacing:.02em;
  transition:opacity .2s,transform .15s;white-space:nowrap;
}
.it-urg__cta:hover{opacity:.84;color:#fff;transform:translateY(-1px)}
.it-urg__cta:active{transform:scale(.97);color:#fff}
.it-urg__cta svg{width:15px;height:15px;flex-shrink:0}
[data-theme="dark"] .it-urg__cta{background:#ede9e2;color:#0a0a0a}
.it-urg__cards{
  display:flex;flex-direction:column;gap:10px;
  flex:1;min-width:270px;
}
.it-urg__card{
  display:flex;align-items:center;gap:14px;
  background:var(--it-surface2,#f2f0ec);
  border:0.5px solid var(--it-border,rgba(0,0,0,.09));
  border-radius:14px;padding:12px 14px;
  transition:border-color .2s,box-shadow .2s;
}
.it-urg__card:hover{
  border-color:rgba(212,175,55,.35);
  box-shadow:0 4px 18px rgba(212,175,55,.10);
}
[data-theme="dark"] .it-urg__card{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.08)}
[data-theme="dark"] .it-urg__card:hover{border-color:rgba(212,175,55,.28)}
.it-urg__img{
  width:72px;height:72px;border-radius:10px;
  background:var(--it-surface,#fff);
  border:0.5px solid var(--it-border,rgba(0,0,0,.09));
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;overflow:hidden;
}
.it-urg__img img{width:62px;height:62px;object-fit:contain}
[data-theme="dark"] .it-urg__img{background:rgba(255,255,255,.06)}
.it-urg__card-info{flex:1;min-width:0}
.it-urg__card-name{
  font-size:12.5px;font-weight:600;color:var(--it-text,#111);
  margin:0 0 3px;line-height:1.3;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
[data-theme="dark"] .it-urg__card-name{color:#ede9e2}
.it-urg__card-price{
  font-size:15px;font-weight:700;
  color:var(--it-accent,#d4af37);margin:0 0 6px;
}
.it-urg__pill{
  display:inline-flex;align-items:center;gap:5px;
  font-size:10px;font-weight:600;
  padding:3px 9px;border-radius:20px;
  background:rgba(21,128,61,.09);
  border:0.5px solid rgba(21,128,61,.22);
  color:#15803d;
}
[data-theme="dark"] .it-urg__pill{
  background:rgba(212,175,55,.09);
  border-color:rgba(212,175,55,.22);
  color:var(--it-accent,#d4af37);
}
.it-urg__pill-dot{width:5px;height:5px;border-radius:50%;background:currentColor}
.it-urg__card-btn{
  flex-shrink:0;
  display:inline-flex;align-items:center;
  height:36px;padding:0 14px;
  border:1.5px solid var(--it-border2,rgba(0,0,0,.18));
  border-radius:9px;text-decoration:none;
  font-size:12px;font-weight:700;
  color:var(--it-text,#111);
  background:transparent;
  transition:border-color .15s,color .15s,background .15s;
  white-space:nowrap;
}
.it-urg__card-btn:hover{
  border-color:var(--it-text,#111);
  color:var(--it-text,#111);
  background:var(--it-surface,#fff);
}
[data-theme="dark"] .it-urg__card-btn{
  border-color:rgba(255,255,255,.18);color:rgba(255,255,255,.8);
}
[data-theme="dark"] .it-urg__card-btn:hover{
  border-color:rgba(255,255,255,.45);color:#fff;
}
@media(max-width:768px){
  .it-urg__inner{flex-direction:column;gap:24px;padding:28px 16px}
  .it-urg__title{font-size:20px}
}
</style>

<div class="it-urg">
  <div class="it-urg__inner">
    <div class="it-urg__left">
      <div class="it-urg__eyebrow">
        <span class="it-urg__eyebrow-dot"></span>
        Recién llegado &middot; Nuevo 2026
      </div>
      <h2 class="it-urg__title">Estrena el nuevo iPhone 17 Pro Max</h2>
      <p class="it-urg__desc">Sellado de fábrica con garantía legal de 3 años. Envío gratis en 24h. Resérvalo por solo 50&euro; y te lo guardamos.</p>
      <a href="/collections/iphones-nuevos-sellados" class="it-urg__cta">
        Ver iPhones disponibles
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <div class="it-urg__cards">
      {%- if p1 != blank -%}
      <div class="it-urg__card">
        <div class="it-urg__img">
          {%- if p1.featured_image -%}
            <img src="{{ p1.featured_image | image_url: width: 140 }}" alt="{{ p1.title | escape }}" width="62" height="62" loading="lazy">
          {%- endif -%}
        </div>
        <div class="it-urg__card-info">
          <p class="it-urg__card-name">{{ p1.title }}</p>
          <p class="it-urg__card-price">{{ p1.price_min | money }}</p>
          <span class="it-urg__pill"><span class="it-urg__pill-dot"></span>Sellado &middot; Nuevo</span>
        </div>
        <a href="{{ p1.url }}" class="it-urg__card-btn">Comprar</a>
      </div>
      {%- endif -%}

      {%- if p2 != blank -%}
      <div class="it-urg__card">
        <div class="it-urg__img">
          {%- if p2.featured_image -%}
            <img src="{{ p2.featured_image | image_url: width: 140 }}" alt="{{ p2.title | escape }}" width="62" height="62" loading="lazy">
          {%- endif -%}
        </div>
        <div class="it-urg__card-info">
          <p class="it-urg__card-name">{{ p2.title }}</p>
          <p class="it-urg__card-price">{{ p2.price_min | money }}</p>
          <span class="it-urg__pill"><span class="it-urg__pill-dot"></span>Sellado &middot; Nuevo</span>
        </div>
        <a href="{{ p2.url }}" class="it-urg__card-btn">Comprar</a>
      </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{"name":"Destacado iPhone","settings":[],"presets":[{"name":"Destacado iPhone"}]}
{% endschema %}
