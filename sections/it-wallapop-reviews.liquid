{%- if section.settings.show_section -%}
<section class="it-section it-wallapop-reviews">
  <div class="it-reviews-header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="it-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="it-section-title">{{ section.settings.title }}</h2>
    <div class="it-wallapop-badge">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="#13c1ac" stroke="#13c1ac" stroke-width="0" stroke-linejoin="round"/>
      </svg>
      <span class="it-wallapop-score">{{ section.settings.rating }} &mdash; {{ section.settings.review_count }} valoraciones verificadas en Wallapop</span>
    </div>
  </div>

  <div class="it-reviews-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'review' and block.settings.text != blank -%}
        <div class="it-review-card" {{ block.shopify_attributes }}>
          <div class="it-review-stars" aria-label="5 estrellas">
            {%- for i in (1..5) -%}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#13c1ac" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {%- endfor -%}
          </div>
          <p class="it-review-text">&ldquo;{{ block.settings.text }}&rdquo;</p>
          <p class="it-review-author">
            <span class="it-review-name">{{ block.settings.name }}</span>
            <span class="it-review-source">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="#13c1ac" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              Wallapop
            </span>
          </p>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.profile_url != blank -%}
    <div class="it-reviews-cta">
      <a href="{{ section.settings.profile_url }}" target="_blank" rel="noopener" class="it-btn-secondary">
        Ver todas las valoraciones en Wallapop &rarr;
      </a>
    </div>
  {%- endif -%}
</section>

<style>
.it-wallapop-reviews{padding:60px 20px;max-width:1100px;margin:0 auto;text-align:center}
.it-wallapop-badge{display:inline-flex;align-items:center;gap:6px;background:#f0fdfb;border:1px solid #13c1ac33;border-radius:20px;padding:6px 14px;margin-top:12px;margin-bottom:0}
.it-wallapop-score{font-size:13px;font-weight:500;color:#0d9488}
.it-reviews-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-top:36px;text-align:left}
.it-review-card{background:var(--it-surface,#fff);border:0.5px solid var(--it-border,#e8e8e4);border-radius:12px;padding:20px;display:flex;flex-direction:column;gap:10px}
.it-review-stars{display:flex;gap:2px}
.it-review-text{font-size:14px;color:var(--it-text,#1a1a1a);line-height:1.6;margin:0;flex:1}
.it-review-author{display:flex;align-items:center;justify-content:space-between;margin:0}
.it-review-name{font-size:13px;font-weight:500;color:var(--it-muted,#6b7280)}
.it-review-source{display:flex;align-items:center;gap:3px;font-size:11px;color:#0d9488;font-weight:500}
.it-reviews-cta{margin-top:32px}
@media(max-width:600px){.it-reviews-grid{grid-template-columns:1fr}}
</style>
{%- endif -%}

{% schema %}
{
  "name": "Valoraciones Wallapop",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Mostrar sección", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño arriba", "default": "Compradores reales" },
    { "type": "text", "id": "title", "label": "Título", "default": "Lo que dicen nuestros clientes" },
    { "type": "text", "id": "rating", "label": "Puntuación (ej: ★★★★★ 5.0)", "default": "★★★★★ 5.0" },
    { "type": "text", "id": "review_count", "label": "Número de valoraciones (ej: 42)", "default": "42" },
    { "type": "url", "id": "profile_url", "label": "Enlace a tu perfil de Wallapop" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Valoración",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Texto de la valoración" },
        { "type": "text", "id": "name", "label": "Nombre del comprador (inicial o nombre)", "default": "A. M." }
      ]
    }
  ],
  "presets": [{
    "name": "Valoraciones Wallapop",
    "blocks": [
      { "type": "review" },
      { "type": "review" },
      { "type": "review" }
    ]
  }]
}
{% endschema %}
