<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  {%- assign product_form_id = 'product-form-' | append: section.id -%}
  {% assign media_size = section.settings.media_size %}
  {% if section.settings.media_size == 'small' %}
    {% assign media_size = 'one-third' %}
  {% elsif section.settings.media_size == 'large' %}
    {% assign media_size = 'two-thirds' %}
  {% endif %}

  <div class="page-width">
    <div
      id="Product-{{ section.id }}"
      class="product product--{{ media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.media_fit }} color-{{ section.settings.color_scheme }} gradient"
      {% if product.selected_or_first_available_variant.featured_media != null %}
        data-has-only-default-variant="{{ product.has_only_default_variant }}"
      {% endif %}
    >
      <div class="product__media-wrapper">
        {%- render 'product-media-gallery',
          product: product,
          variant_images: variant_images,
          mobile_layout: section.settings.mobile_layout,
          desktop_layout: section.settings.desktop_layout,
          media_size: media_size,
          media_fit: section.settings.media_fit,
          product_form_id: product_form_id,
          variants_available: section.settings.inventory_availability,
          image_zoom: section.settings.image_zoom -%}
      </div>
      <div id="ProductInfo-{{ section.id }}" class="product__info-wrapper">
        {%- for block in section.blocks -%}
          {% case block.type %}
            {% when 'border' %}
              <hr class="product__info-divider" {{ block.shopify_attributes }}>
            {% when 'title' %}
              {%- if section.settings.enable_sticky_info -%}
                <div class="product-media-mobile-header">
                {%- endif -%}
              <div class="product__title-wrapper" {{ block.shopify_attributes }}>
                {%- if section.settings.show_vendor -%}
                  <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
                  <div class="product__vendor">{{ product.vendor }}</div>
                {%- endif -%}
                {%- if product.tags contains 'Customizable' -%}
                  <a href="/pages/customize"> {{ product.title }} </a>
                {%- else -%}
                  {{ product.title }}
                {%- endif -%}
              </div>
              {%- if section.settings.enable_sticky_info -%}
                </div>
              {%- endif -%}
            {% when 'price' %}
              <div id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                {%- render 'product-price',
                  product: product,
                  use_variant: true,
                  show_badges: true,
                  price_class: 'price--large' -%}
              </div>
            {% when 'inventory' %}
              {%- if section.settings.inventory_availability != false -%}
                <p class="product__inventory" id="Inventory-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                  {%- if product.selected_or_first_available_variant.available -%}
                    <span class="it-inv-dot"></span> En stock &middot; listo para enviar
                  {%- endif -%}
                </p>
              {%- endif -%}
            {% when 'variant_picker' %}
              {%- render 'product-variant-picker',
                product: product,
                block: block,
                product_form_id: product_form_id -%}
            {% when 'buy_buttons' %}
              {%- render 'buy-buttons',
                product: product,
                block: block,
                product_form_id: product_form_id,
                section_id: section.id,
                show_pickup_availability: true -%}
            {% when 'text' %}
              <p class="product__text" {{ block.shopify_attributes }}>{{ block.settings.text | newline_to_br }}</p>
            {% when 'quantity_selector' %}
              {%- render 'product-quantity' -%}
            {% when 'buy-buttons' %}
              {%- render 'buy-buttons',
                product: product,
                block: block,
                product_form_id: product_form_id,
                section_id: section.id -%}
            {% when 'description' %}
              {%- if product.description != blank -%}
                <div class="product__description" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>
              {%- endif -%}
            {% when 'share' %}
              {%- render 'social-sharing',
                share_title: product.title,
                share_permalink: product.url,
                share_image: product.featured_image -%}
            {% when 'custom_liquid' %}
              {% if block.settings.custom_liquid != blank %}
                <div class="product__custom-liquid" {% if block.settings.custom_liquid != blank %}{{ block.shopify_attributes }}{% endif %}>
                  {{ block.settings.custom_liquid }}
                </div>
              {% endif %}
            {% when 'accordion' %}
              {%- render 'accordion', block: block -%}
            {% when 'product_rating' %}
              {%- render 'product-rating', product: product -%}
          {% endcase %}
        {%- endfor -%}
        </div>
    </div>
  </div>
</product-info>

<style>
  /* Galería: imagen grande principal, miniaturas claras y color seleccionado resaltado */
  #MediaGallery-{{ section.id }} .product__media-item img { border-radius: 12px; }
  #MediaGallery-{{ section.id }} .thumbnail-list__item .thumbnail {
    border-radius: 8px;
    transition: border-color .18s, box-shadow .18s, transform .18s;
  }
  #MediaGallery-{{ section.id }} .thumbnail[aria-current="true"] {
    border: 2px solid var(--it-accent, #d4af37) !important;
    box-shadow: 0 0 0 2px rgba(212,175,55,.35);
    transform: translateY(-1px);
  }
</style>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Product"
    },
    {
      "type": "select",
      "id": "media_size",
      "label": "Media size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Media fit",
      "options": [
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "cover",
          "label": "Cover"
        }
      ],
      "default": "contain"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Desktop gallery layout",
      "options": [
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "thumbnail",
          "label": "Thumbnails"
        },
        {
          "value": "thumbnail_slider",
          "label": "Thumbnail slider"
        }
      ],
      "default": "thumbnail_slider"
    },
    {
      "type": "select",
      "id": "mobile_thumbnails",
      "label": "Mobile thumbnails",
      "options": [
        {
          "value": "show",
          "label": "Show"
        },
        {
          "value": "hide",
          "label": "Hide"
        }
      ],
      "default": "hide"
    },
    {
      "type": "checkbox",
      "id": "constrain_to_viewport",
      "label": "Constrain to viewport",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_variants",
      "label": "Hide unselected variant media",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Enable video looping",
      "default": false
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Desktop media position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "stack",
          "label": "Stack"
        },
        {
          "value": "columns",
          "label": "Columns"
        }
      ],
      "default": "stack"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "options": [
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "thumbnails",
          "label": "Thumbnails"
        }
      ],
      "default": "thumbnails"
    },
    {
      "type": "select",
      "id": "image_zoom",
      "label": "Image zoom",
      "options": [
        {
          "value": "hover",
          "label": "Hover"
        },
        {
          "value": "open",
          "label": "Open"
        },
        {
          "value": "disabled",
          "label": "Disabled"
        }
      ],
      "default": "hover"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "Enable sticky content on desktop",
      "default": true
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "paragraph",
      "content": "Add a video, image, or 3D model to the product's media section."
    },
    {
      "type": "checkbox",
      "id": "inventory_availability",
      "label": "Show inventory availability",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quantity_selector",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "inventory",
      "name": "Inventory",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "options": [
            { "value": "dropdown", "label": "Dropdown" },
            { "value": "button", "label": "Pills" }
          ],
          "default": "button",
          "label": "Type"
        },
        {
          "type": "select",
          "id": "swatch_shape",
          "options": [
            { "value": "circle", "label": "Circle" },
            { "value": "square", "label": "Square" },
            { "value": "none", "label": "None" }
          ],
          "default": "circle",
          "label": "Swatch shape"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout buttons",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_gift_card_recipient",
          "label": "Show gift card recipient form",
          "default": false
        }
      ]
    },
    {
      "type": "delivery_estimator",
      "name": "Delivery",
      "limit": 1
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Use this text to share information about your product.</p>"
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "Quantity selector",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "share",
      "name": "Share",
      "limit": 1
    },
    {
      "type": "custom_liquid",
      "name": "Custom liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Liquid"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add details on availability, style, or even provide a review.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        }
      ]
    },
    {
      "type": "product_rating",
      "name": "Product rating",
      "limit": 1
    },
    {
      "type": "border",
      "name": "Border"
    }
  ],
  "presets": [
    {
      "name": "Product"
    }
  ]
}
{% endschema %}
