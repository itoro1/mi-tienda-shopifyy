{%- comment -%}
  Boton de modo claro/oscuro.

  Historial, por si vuelve a dar guerra:
    - Fijo arriba a la derecha: se comia el icono del carrito.
    - Fijo abajo a la izquierda: tapaba los botones de variante.
    - Fijo abajo a la derecha sobre WhatsApp: quedaba suelto.
    - Fijo arriba midiendo el header en cada scroll: se quedaba descolgado a
      media pagina. Con position:fixed el boton vive fuera del header, asi que
      al esconderse este (Dawn oculta el header sticky al bajar) el boton se
      quedaba flotando sobre el contenido.

  Solucion definitiva: el boton deja de estar fijo y se MUEVE DENTRO del propio
  header, colocado en el hueco entre el boton de menu y el nombre de la tienda.
  Al ser hijo del header hereda su comportamiento sin una linea de JS de
  posicionamiento: sube, baja, se oculta y reaparece exactamente igual que
  "ITorostore".
{%- endcomment -%}
<style>
  #itThemeBtn{
    /* De partida fuera de la vista: el JS lo mete en el header enseguida.
       Asi no aparece un instante en la esquina antes de colocarse. */
    position:absolute;
    top:-9999px;
    left:-9999px;
    z-index:5;
    width:26px;
    height:26px;
    border-radius:50%;
    border:0.5px solid rgba(128,128,128,.22);
    background:transparent;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:13px;
    line-height:1;
    padding:0;
    opacity:.6;
    transition:opacity .18s;
    -webkit-tap-highlight-color:transparent;
  }
  #itThemeBtn:hover,
  #itThemeBtn:focus-visible{opacity:1}
  #itThemeBtn:active{transform:translateY(-50%) scale(.92)}
  /* Ya colocado dentro del header, centrado en su fila. */
  #itThemeBtn.is-placed{transform:translateY(-50%)}
</style>

<button id="itThemeBtn" type="button" aria-label="Cambiar modo claro/oscuro"><span id="itThemeIcon">☀️</span></button>

<script>
(function(){
  var saved = localStorage.getItem('it-theme') || 'light';
  document.documentElement.setAttribute('data-theme', saved);

  var btn = document.getElementById('itThemeBtn');
  var ic  = document.getElementById('itThemeIcon');
  if(ic) ic.textContent = saved === 'dark' ? '🌙' : '☀️';
  if(!btn) return;

  btn.addEventListener('click', function(){
    var cur  = document.documentElement.getAttribute('data-theme');
    var next = cur === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', next);
    try{ localStorage.setItem('it-theme', next); }catch(e){}
    if(ic) ic.textContent = next === 'dark' ? '🌙' : '☀️';
  });

  function visible(el){
    if(!el) return false;
    var r = el.getBoundingClientRect();
    return r.width > 0 && r.height > 0;
  }

  /* Mete el boton DENTRO del header. A partir de ahi se mueve con el. */
  function colocar(){
    var header = document.querySelector('header.header')
              || document.querySelector('.header-wrapper .header')
              || document.querySelector('.header');
    if(!header) return false;

    var cs = window.getComputedStyle(header);
    if(cs.position === 'static'){ header.style.position = 'relative'; }

    if(btn.parentNode !== header){ header.appendChild(btn); }

    /* Justo despues del boton de menu (movil). En escritorio no existe, asi
       que se pone a la izquierda del grupo de iconos de la derecha. */
    var burger = header.querySelector('.header__icon--menu, .header__icon--summary');
    if(visible(burger)){
      btn.style.left  = (burger.offsetLeft + burger.offsetWidth + 10) + 'px';
      btn.style.right = 'auto';
    } else {
      var icons = header.querySelector('.header__icons');
      if(visible(icons)){
        btn.style.left  = 'auto';
        btn.style.right = (header.offsetWidth - icons.offsetLeft + 10) + 'px';
      } else {
        btn.style.left  = '64px';
        btn.style.right = 'auto';
      }
    }
    btn.style.top = '50%';
    btn.classList.add('is-placed');
    return true;
  }

  function intentar(){
    if(colocar()) return;
    /* El header puede tardar en existir (secciones diferidas): reintento corto. */
    var n = 0;
    var t = setInterval(function(){
      if(colocar() || ++n > 20){ clearInterval(t); }
    }, 150);
  }

  if(document.readyState !== 'loading'){ intentar(); }
  else { document.addEventListener('DOMContentLoaded', intentar); }
  window.addEventListener('load', colocar);
  /* Solo al cambiar el ancho: la posicion vertical ya la lleva el header. */
  window.addEventListener('resize', colocar);
  /* Shopify vuelve a pintar secciones en el editor de temas. */
  document.addEventListener('shopify:section:load', colocar);
})();

/* Se mantienen por compatibilidad: otras partes del tema las llaman. */
function itToggleTheme(){
  var cur  = document.documentElement.getAttribute('data-theme');
  var next = cur === 'light' ? 'dark' : 'light';
  document.documentElement.setAttribute('data-theme', next);
  try{ localStorage.setItem('it-theme', next); }catch(e){}
  var ic = document.getElementById('itThemeIcon');
  if(ic) ic.textContent = next === 'dark' ? '🌙' : '☀️';
}
function itUpdateThemeUI(t){
  var ic = document.getElementById('itThemeIcon');
  if(ic) ic.textContent = t === 'dark' ? '🌙' : '☀️';
}
</script>
