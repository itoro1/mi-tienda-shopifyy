{%- comment -%}
  Boton de modo claro/oscuro.

  Posiciones que se han probado y por que se descartaron:
    - Arriba a la derecha fijo: se comia el icono del carrito.
    - Abajo a la izquierda: tapaba los botones de variante del producto.
    - Abajo a la derecha sobre WhatsApp: quedaba suelto y estorbaba igual.

  Ahora se ancla al header: se coloca en el hueco que hay entre el boton de
  menu (las tres rayitas) y el nombre de la tienda. Como el header es sticky y
  la barra de anuncios de arriba si se va con el scroll, la posicion no puede
  ser un valor fijo en CSS: se mide el header en cada scroll y se centra sobre
  el. En escritorio no hay tres rayitas, asi que alli se coloca a la izquierda
  del grupo de iconos de la derecha, que es el unico hueco libre.
{%- endcomment -%}
<style>
  #itThemeBtn{
    position:fixed;
    top:14px;              /* valor de partida; el JS lo ajusta al header real */
    left:72px;
    z-index:9700;
    width:26px;
    height:26px;
    border-radius:50%;
    border:0.5px solid rgba(128,128,128,.22);
    background:transparent;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:12px;
    line-height:1;
    padding:0;
    opacity:.55;
    transition:opacity .18s;
    -webkit-tap-highlight-color:transparent;
  }
  #itThemeBtn:hover,
  #itThemeBtn:focus-visible{opacity:1}
  #itThemeBtn:active{transform:scale(.92)}

  /* Con el cajon del carrito o el menu abiertos sobra y taparia contenido. */
  body:has(cart-drawer.active) #itThemeBtn,
  body:has(cart-drawer.animate.active) #itThemeBtn,
  body.it-cart-open #itThemeBtn{display:none !important}
</style>

<button
  id="itThemeBtn"
  type="button"
  aria-label="Cambiar modo claro/oscuro"
><span id="itThemeIcon">☀️</span></button>

<script>
(function(){
  /* --- Estado guardado --- */
  var saved = localStorage.getItem('it-theme') || 'light';
  document.documentElement.setAttribute('data-theme', saved);

  var btn = document.getElementById('itThemeBtn');
  var ic  = document.getElementById('itThemeIcon');
  if(ic) ic.textContent = saved === 'dark' ? '🌙' : '☀️';
  if(!btn) return;

  btn.addEventListener('click', function(){
    var cur  = document.documentElement.getAttribute('data-theme');
    var next = cur === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', next);
    try{ localStorage.setItem('it-theme', next); }catch(e){}
    if(ic) ic.textContent = next === 'dark' ? '🌙' : '☀️';
  });

  /* --- Anclaje al header ---
     El header es sticky pero la barra de anuncios no, asi que la fila del
     header cambia de altura al hacer scroll. Se recalcula en cada scroll. */
  function visible(el){
    if(!el) return false;
    var r = el.getBoundingClientRect();
    return r.width > 0 && r.height > 0;
  }

  function place(){
    var header = document.querySelector('sticky-header')
              || document.querySelector('.header-wrapper')
              || document.querySelector('header.header')
              || document.querySelector('.header');
    if(!header) return;

    var hr = header.getBoundingClientRect();
    if(hr.height === 0) return;

    /* Centrado vertical sobre la fila del header. */
    var top = hr.top + (hr.height - btn.offsetHeight) / 2;
    btn.style.top = Math.max(4, top) + 'px';

    /* Horizontal: justo despues de las tres rayitas si estan (movil), o a la
       izquierda del grupo de iconos de la derecha si no (escritorio). */
    var burger = header.querySelector('.header__icon--menu, .header__icon--summary');
    if(visible(burger)){
      btn.style.left  = (burger.getBoundingClientRect().right + 12) + 'px';
      btn.style.right = 'auto';
    } else {
      var icons = header.querySelector('.header__icons');
      if(visible(icons)){
        btn.style.left  = 'auto';
        btn.style.right = (window.innerWidth - icons.getBoundingClientRect().left + 12) + 'px';
      } else {
        btn.style.left  = '72px';
        btn.style.right = 'auto';
      }
    }
  }

  function schedule(){ window.requestAnimationFrame(place); }

  if(document.readyState !== 'loading'){ schedule(); }
  else { document.addEventListener('DOMContentLoaded', schedule); }
  window.addEventListener('load', schedule);
  window.addEventListener('scroll', schedule, {passive:true});
  window.addEventListener('resize', schedule);
})();

/* Se mantienen por compatibilidad: otras partes del tema las llaman. */
function itToggleTheme(){
  var cur  = document.documentElement.getAttribute('data-theme');
  var next = cur === 'light' ? 'dark' : 'light';
  document.documentElement.setAttribute('data-theme', next);
  try{ localStorage.setItem('it-theme', next); }catch(e){}
  var ic = document.getElementById('itThemeIcon');
  if(ic) ic.textContent = next === 'dark' ? '🌙' : '☀️';
}
function itUpdateThemeUI(t){
  var ic = document.getElementById('itThemeIcon');
  if(ic) ic.textContent = t === 'dark' ? '🌙' : '☀️';
}
</script>
