    </svg>
  </a>
  <button class="it-wa-close" id="itWaClose" aria-label="Cerrar WhatsApp">&times;</button>
</div>

<style>
.it-wa-wrap{position:fixed;bottom:24px;right:20px;z-index:9980;display:flex;flex-direction:column;align-items:flex-end;gap:8px}
.it-wa-btn{display:flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:50%;background:#25d366;box-shadow:0 4px 16px rgba(37,211,102,.45);transition:transform .2s,box-shadow .2s;flex-shrink:0}
.it-wa-btn:hover{transform:scale(1.08);box-shadow:0 6px 20px rgba(37,211,102,.55)}
.it-wa-btn svg{width:30px;height:30px;fill:#fff}
.it-wa-bubble{background:#fff;border-radius:12px 12px 0 12px;padding:8px 14px;font-size:13px;color:#1a1a1a;box-shadow:0 2px 12px rgba(0,0,0,.15);max-width:200px;line-height:1.4;animation:itWaPop .3s ease}
.it-wa-close{position:absolute;top:-8px;right:-8px;width:20px;height:20px;border-radius:50%;background:#6b7280;border:none;color:#fff;font-size:13px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0}
.it-wa-close:hover{background:#374151}
@keyframes itWaPop{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:600px){.it-wa-wrap{bottom:16px;right:14px}.it-wa-btn{width:52px;height:52px}}
</style>

<script>
(function(){
  var wrap = document.getElementById('itWaWrap');
  var bubble = document.getElementById('itWaBubble');
  var closeBtn = document.getElementById('itWaClose');

  if(sessionStorage.getItem('it-wa-closed')) return;

  setTimeout(function(){ if(bubble) bubble.style.display='block'; }, 3000);

  if(closeBtn){
    closeBtn.addEventListener('click', function(){
      wrap.style.display='none';
      sessionStorage.setItem('it-wa-closed','1');
    });
  }
})();
</script>
