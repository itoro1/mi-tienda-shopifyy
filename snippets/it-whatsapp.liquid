<style>
.it-wa-wrap{
  position:fixed;
  bottom:24px;
  right:20px;
  z-index:9980;
  display:flex;
  flex-direction:column;
  align-items:flex-end;
  gap:8px;
}
.it-wa-btn{
  display:flex;
  align-items:center;
  justify-content:center;
  width:56px;
  height:56px;
  border-radius:50%;
  background:#25d366;
  box-shadow:0 4px 16px rgba(37,211,102,.45);
  transition:transform .2s,box-shadow .2s;
  flex-shrink:0;
}
.it-wa-btn:hover{transform:scale(1.08);box-shadow:0 6px 20px rgba(37,211,102,.55)}
.it-wa-btn svg{width:30px;height:30px;fill:#fff}
.it-wa-bubble{
  background:#fff;
  border-radius:12px 12px 0 12px;
  padding:8px 14px;
  font-size:13px;
  color:#1a1a1a;
  box-shadow:0 2px 12px rgba(0,0,0,.15);
  max-width:200px;
  line-height:1.4;
  animation:itWaPop .3s ease;
}
@keyframes itWaPop{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.it-wa-close{
  position:absolute;
  top:-8px;
  right:-8px;
  width:22px;
  height:22px;
  border-radius:50%;
  background:#fff;
  border:0.5px solid rgba(0,0,0,.15);
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  color:#555;
  padding:0;
  z-index:1;
  box-shadow:0 1px 4px rgba(0,0,0,.15);
}
.it-wa-close:hover{background:#f5f5f5;color:#222}
@media(max-width:600px){
  .it-wa-wrap{bottom:16px;right:14px}
  .it-wa-btn{width:52px;height:52px}
}
</style>
<script>
(function(){
  try {
    if (sessionStorage.getItem('itWaClosed') === '1') {
      var el = document.getElementById('it-wa-wrap');
      if (el) el.style.display = 'none';
    }
  } catch(e) {}
  var btn = document.getElementById('it-wa-close');
  if (btn) {
    btn.addEventListener('click', function() {
      var wrap = document.getElementById('it-wa-wrap');
      if (wrap) wrap.style.display = 'none';
      try { sessionStorage.setItem('itWaClosed', '1'); } catch(e) {}
    });
  }
})();
</script>
