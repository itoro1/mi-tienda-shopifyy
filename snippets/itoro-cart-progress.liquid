<style>
.icp{--icp-bg:#ffffff;--icp-text:#1a1a1a;--icp-text2:#666;--icp-border:rgba(0,0,0,.10);--icp-green:#166534;--icp-green-bg:#dcfce7;--icp-gold:#d4af37}
[data-theme="dark"] .icp{--icp-bg:#111113;--icp-text:#ede9e2;--icp-text2:#888;--icp-border:rgba(255,255,255,.10);--icp-green:#4ade80;--icp-green-bg:rgba(34,197,94,.12)}
.icp__bar-wrap{padding:14px 18px;background:var(--icp-bg);border-bottom:.5px solid var(--icp-border);display:flex;align-items:center;justify-content:center;gap:8px;transition:background .35s}
.icp__free-ship{display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600;color:var(--icp-green)}
.icp__free-ship svg{width:16px;height:16px;flex-shrink:0}
/* ---------------------------------------------------------------------------
   Layout del cajon del carrito.

   component-cart-drawer.css declara .drawer__inner dos veces: primero como
   flex en columna y despues, mas abajo, como "display:grid;
   grid-template-rows:1fr;align-items:center". Gana la segunda. Con grid de una
   sola pista y overflow:hidden en el contenedor, los hijos que no caben se
   recortan y ademas no hay forma de hacer scroll hasta ellos: por eso, con un
   iPhone sin cargador en el carrito, el bloque de accesorios ocupaba la parte
   de arriba y el boton de finalizar compra quedaba cortado y fuera de alcance.

   Se restituye la columna flexible: la zona de articulos hace scroll, el pie
   con el boton de pagar queda fijo abajo, y el bloque de accesorios (order:1)
   se coloca al final, donde no compite con el boton.
   --------------------------------------------------------------------------- */
cart-drawer .drawer__inner{
  display:flex;
  flex-direction:column;
  align-items:stretch;
  overflow:hidden;
}
cart-drawer .drawer__header{flex:0 0 auto}
cart-drawer .cart-drawer__form{
  flex:1 1 auto;
  min-height:0;
  display:flex;
  flex-direction:column;
  overflow:hidden;
}
cart-drawer .drawer__contents{
  flex:1 1 auto;
  min-height:0;
  overflow-y:auto;
  -webkit-overflow-scrolling:touch;
}
cart-drawer .drawer__footer{flex:0 0 auto}
.icp-upsell-wrap{order:1;flex:0 0 auto}
.icp__upsell{margin:12px 16px;background:var(--icp-green-bg);border:.5px solid var(--icp-green);border-radius:12px;padding:12px 14px;display:none;transition:background .35s,border-color .35s}
.icp__upsell--show{display:block}
.icp__upsell-label{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--icp-green);margin-bottom:10px}
.icp__upsell-list{display:flex;flex-direction:column;gap:8px}
.icp__upsell-item{display:flex;align-items:center;gap:10px}
.icp__upsell-img{width:44px;height:44px;border-radius:8px;background:var(--icp-bg);border:.5px solid var(--icp-border);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;overflow:hidden}
.icp__upsell-img img{width:100%;height:100%;object-fit:cover}
.icp__upsell-info{flex:1;min-width:0}
.icp__upsell-name{font-size:12.5px;font-weight:500;color:var(--icp-text);line-height:1.3}
.icp__upsell-price{font-size:12px;color:var(--icp-text2);margin-top:1px}
.icp__upsell-btn{flex-shrink:0;padding:7px 14px;background:var(--icp-text);color:var(--icp-bg);border:none;border-radius:20px;font-size:12px;font-weight:500;cursor:pointer;font-family:inherit;transition:opacity .18s,background .35s,color .35s;white-space:nowrap}
.icp__upsell-btn:hover{opacity:.82}
.icp__upsell-btn.loading{opacity:.5;cursor:not-allowed}
</style>

<div class="icp">
  <div class="icp__bar-wrap">
    <span class="icp__free-ship">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      Envío gratis incluido
    </span>
  </div>
</div>

{%- assign has_iphone = false -%}
{%- assign has_charger = false -%}
{%- for item in cart.items -%}
  {%- if item.product.type == 'Smartphone' -%}
    {%- assign has_iphone = true -%}
  {%- endif -%}
  {%- if item.product.type == 'Cargador' or item.product.type == 'Cable' -%}
    {%- assign has_charger = true -%}
  {%- endif -%}
{%- endfor -%}

{%- if has_iphone and has_charger == false -%}
  {%- assign upsell_products = collections['cargadores-y-cables'].products -%}
  {%- if upsell_products.size > 0 -%}
    <div class="icp icp-upsell-wrap">
      <div class="icp__upsell icp__upsell--show">
        <p class="icp__upsell-label">Completa tu pedido</p>
        <div class="icp__upsell-list">
          {%- comment -%}
            El limite va aqui, en el for. Antes estaba escrito como filtro
            (| limit: 2) sobre la lista, que no existe en Liquid: se ignoraba
            en silencio y se pintaba la coleccion entera, cinco productos.
          {%- endcomment -%}
          {%- for up in upsell_products limit: 2 -%}
            <div class="icp__upsell-item">
              <div class="icp__upsell-img">
                {%- if up.featured_image -%}
                  <img src="{{ up.featured_image | image_url: width: 88 }}" alt="{{ up.title }}" loading="lazy">
                {%- else -%}
                  🔌
                {%- endif -%}
              </div>
              <div class="icp__upsell-info">
                <p class="icp__upsell-name">{{ up.title }}</p>
                <p class="icp__upsell-price">{{ up.price | money }}</p>
              </div>
              <button class="icp__upsell-btn" onclick="icpAddToCart(this, {{ up.variants.first.id }})">+ Añadir</button>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

<script>
function icpAddToCart(btn, variantId) {
  btn.classList.add('loading');
  btn.textContent = '...';
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: variantId, quantity: 1 })
  })
  .then(r => r.json())
  .then(() => {
    btn.textContent = '✓ Añadido';
    btn.style.background = '#166534';
    btn.classList.remove('loading');
    setTimeout(() => location.reload(), 800);
  })
  .catch(() => {
    btn.textContent = 'Error';
    btn.classList.remove('loading');
  });
}
</script>
