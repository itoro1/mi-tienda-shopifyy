{% comment %}
  Reservation UI — shown when a product has 0 inventory (bajo pedido).
  Accepts: product
{% endcomment %}

{%- capture reserva_vid -%}{%- render 'itoro-reserva-vid', product: product -%}{%- endcapture -%}
{%- assign reserva_vid = reserva_vid | strip -%}
{%- comment -%}
  Si ninguna variante esta disponible, selected_or_first_available_variant puede
  venir vacia y la reserva llegaria al carrito sin modelo ni color. Se usa la
  primera variante como respaldo.
{%- endcomment -%}
{%- assign it_variant = product.selected_or_first_available_variant | default: product.variants.first -%}

<div class="itoro-reserva-wrap">

  <!-- Red stock indicator -->
  <p class="itoro-sin-stock">
    <span class="itoro-sin-stock-dot"></span>
    Sin stock disponible
  </p>

  <!-- Info box -->
  <div class="itoro-reserva-box">
    <div class="itoro-reserva-box-head">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      Disponible bajo pedido &mdash; 3 a 5 d&iacute;as h&aacute;biles
    </div>
    <p class="itoro-reserva-box-desc">
      Reserva tu unidad con un <strong>dep&oacute;sito de 50&euro;</strong>. En cuanto llegue al almac&eacute;n te lo enviamos con seguimiento incluido. Los 50&euro; se descuentan del precio final.
    </p>
    <ul class="itoro-reserva-list">
      <li>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        Los 50&euro; se descuentan del precio final
      </li>
      <li>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        Plazo estimado: 3 a 5 d&iacute;as h&aacute;biles
      </li>
      <li>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        Te avisamos por email y WhatsApp cuando est&eacute; listo
      </li>
    </ul>
  </div>

  <!-- Reservation form — adds €50 deposit product to cart with iPhone note -->
  <form action="/cart/add" method="post" id="itoro-reserva-form" class="itoro-reserva-form">
    <input type="hidden" name="id" value="{{ reserva_vid }}">
    <input type="hidden" name="return_to" value="/cart">
    <input type="hidden" name="properties[iPhone reservado]"
      value="{{ product.title }}{% if product.variants.size > 1 %} &middot; {{ it_variant.title }}{% endif %}">
    <input type="hidden" name="properties[Almacenamiento]" value="{{ it_variant.option1 }}">
    <input type="hidden" name="properties[Color]" value="{{ it_variant.option2 }}">
    <button type="submit" class="button button--full-width button--primary itoro-reserva-btn" id="itoro-reserva-submit">
      <svg class="itoro-reserva-btn-ic" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="3"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
      <span id="itoro-reserva-label">Reservar ahora &middot; 50&euro;</span>
      {%- render 'loading-spinner' -%}
    </button>
    <p class="itoro-reserva-btn-sub">Sin compromiso &middot; Los 50&euro; se descuentan del total</p>
  </form>

  <!-- Trust badges (same as normal buy-buttons) -->
  {{ 'itoro-trust.css' | asset_url | stylesheet_tag }}
  <div class="itoro-shipping-badge" style="margin-top:12px">
    <span class="itoro-shipping-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
    </span>
    <div class="itoro-shipping-text">
      <strong>Env&iacute;o gratis &middot; 3&ndash;5 d&iacute;as h&aacute;biles</strong>
      <span>Correos a toda Espa&ntilde;a &middot; Seguimiento incluido</span>
    </div>
  </div>
  <div class="itoro-trust-row">
    <span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      Pago seguro
    </span>
    <span class="it-sep">&bull;</span>
    <span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      Env&iacute;o gratis
    </span>
    <span class="it-sep">&bull;</span>
    <span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Garant&iacute;a incluida
    </span>
  </div>
</div>

<style>
.itoro-reserva-wrap { }

.itoro-sin-stock {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  font-weight: 600;
  color: #dc2626;
  margin: 0 0 14px;
  letter-spacing: .01em;
}
.itoro-sin-stock-dot {
  display: inline-block;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #dc2626;
  flex-shrink: 0;
  box-shadow: 0 0 0 3px rgba(220,38,38,.18);
}

.itoro-reserva-box {
  background: #fff8f0;
  border: 0.5px solid #fdba74;
  border-radius: 10px;
  padding: 14px 16px;
  margin-bottom: 14px;
}
[data-theme="dark"] .itoro-reserva-box {
  background: rgba(251,146,60,.07);
  border-color: rgba(251,146,60,.25);
}

.itoro-reserva-box-head {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 13.5px;
  font-weight: 700;
  color: #c2410c;
  margin-bottom: 8px;
}
[data-theme="dark"] .itoro-reserva-box-head { color: #fb923c; }

.itoro-reserva-box-desc {
  font-size: 13px;
  color: #4b4b47;
  line-height: 1.55;
  margin: 0 0 10px;
}
[data-theme="dark"] .itoro-reserva-box-desc { color: rgba(237,233,226,.75); }

.itoro-reserva-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.itoro-reserva-list li {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: #6b6b68;
  line-height: 1.4;
}
.itoro-reserva-list li svg { flex-shrink: 0; color: #c2410c; }
[data-theme="dark"] .itoro-reserva-list li { color: rgba(237,233,226,.55); }

.itoro-reserva-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 56px;
  padding: 0 24px;
  background: linear-gradient(135deg, #111114 0%, #2a2a30 100%);
  color: #fff;
  border: 1px solid rgba(212,175,55,.45);
  border-radius: 14px;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: .01em;
  cursor: pointer;
  box-shadow: 0 10px 26px rgba(0,0,0,.22), inset 0 1px 0 rgba(255,255,255,.07);
  transition: transform .18s cubic-bezier(.4,0,.2,1), box-shadow .25s, border-color .25s;
  -webkit-tap-highlight-color: transparent;
}
.itoro-reserva-btn::after { display: none; }
.itoro-reserva-btn:hover {
  transform: translateY(-2px);
  border-color: rgba(212,175,55,.95);
  box-shadow: 0 16px 36px rgba(0,0,0,.30), 0 0 0 1px rgba(212,175,55,.30);
  color: #fff;
}
.itoro-reserva-btn:active { transform: translateY(0); box-shadow: 0 6px 16px rgba(0,0,0,.22); }
.itoro-reserva-btn-ic { flex-shrink: 0; color: #e8c66a; }
.itoro-reserva-btn-sub {
  text-align: center;
  font-size: 11.5px;
  color: #8a8a86;
  margin: 9px 0 0;
  letter-spacing: .01em;
}
[data-theme="dark"] .itoro-reserva-btn {
  background: linear-gradient(135deg, #17171a 0%, #2e2e34 100%);
  border-color: rgba(212,175,55,.55);
}
[data-theme="dark"] .itoro-reserva-btn-sub { color: rgba(237,233,226,.5); }
</style>

<script>
/* Update "iPhone reservado" property when variant changes */
(function(){
  var propInput = document.querySelector('#itoro-reserva-form input[name="properties[iPhone reservado]"]');
  if(!propInput) return;
  var baseTitle = {{ product.title | json }};

  function updateProp(){
    var input = document.querySelector('product-info input[name="id"], .product-variant-id, form[data-type="add-to-cart-form"] input[name="id"]');
    if(!input) return;
    var vid = input.value;
    /* Find matching variant title from Shopify variants JSON */
    var variants = {{ product.variants | json }};
    var v = variants.find(function(x){ return String(x.id) === String(vid); });
    var label = baseTitle;
    if(v && v.title && v.title !== 'Default Title'){
      label += ' · ' + v.title;
    }
    propInput.value = label;
    var almInput = document.querySelector('#itoro-reserva-form input[name="properties[Almacenamiento]"]');
    var colInput = document.querySelector('#itoro-reserva-form input[name="properties[Color]"]');
    if(v){
      if(almInput) almInput.value = v.option1 || '';
      if(colInput) colInput.value = v.option2 || '';
    }
  }

  document.addEventListener('variant:change', updateProp);
  document.addEventListener('DOMContentLoaded', updateProp);
})();
</script>
