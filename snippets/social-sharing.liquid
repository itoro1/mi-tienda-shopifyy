{% comment %} Minimal social-sharing snippet (restores missing asset). {% endcomment %}
<share-button
  class="share-button"
  data-share-url="{{ share_permalink | default: product.url | prepend: request.origin }}"
>
  <button class="share-button__button hidden-no-js" aria-label="Compartir">
    <span class="svg-wrapper">
      <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" aria-hidden="true"><path d="M13.5 6.5a2.5 2.5 0 1 0-2.45-3H11a2.5 2.5 0 0 0 .05.5L6.9 6.6a2.5 2.5 0 1 0 0 3.8l4.15 2.6A2.5 2.5 0 1 0 12 12l-4.2-2.6a2.5 2.5 0 0 0 0-.8L12 6a2.49 2.49 0 0 0 1.5.5z" fill="currentColor"/></svg>
    </span>
    Compartir
  </button>
  <details id="Details-share-{{ section.id }}" class="share-button__fallback" hidden>
    <summary class="share-button__button">
      <span class="svg-wrapper">
        <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" aria-hidden="true"><path d="M13.5 6.5a2.5 2.5 0 1 0-2.45-3H11a2.5 2.5 0 0 0 .05.5L6.9 6.6a2.5 2.5 0 1 0 0 3.8l4.15 2.6A2.5 2.5 0 1 0 12 12l-4.2-2.6a2.5 2.5 0 0 0 0-.8L12 6a2.49 2.49 0 0 0 1.5.5z" fill="currentColor"/></svg>
      </span>
      Compartir
    </summary>
    <div class="share-button__mobile" id="Product-share-{{ section.id }}">
      <div class="field">
        <span id="ShareMessage-{{ section.id }}" class="share-button__message hidden" role="status"></span>
        <input
          type="text"
          class="field__input"
          id="ShareUrl-{{ section.id }}"
          value="{{ share_permalink | default: product.url | prepend: request.origin }}"
          readonly
        >
        <label class="field__label" for="ShareUrl-{{ section.id }}">Enlace</label>
      </div>
    </div>
  </details>
</share-button>
