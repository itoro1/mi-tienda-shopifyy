{% comment %} Minimal social-sharing snippet — single "Compartir" disclosure (no duplicate). {% endcomment %}
<details class="share-button" id="Details-share-{{ section.id }}">
  <summary class="share-button__button" aria-label="Compartir">
    <span class="svg-wrapper">
      <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" aria-hidden="true"><path d="M13.5 6.5a2.5 2.5 0 1 0-2.45-3H11a2.5 2.5 0 0 0 .05.5L6.9 6.6a2.5 2.5 0 1 0 0 3.8l4.15 2.6A2.5 2.5 0 1 0 12 12l-4.2-2.6a2.5 2.5 0 0 0 0-.8L12 6a2.49 2.49 0 0 0 1.5.5z" fill="currentColor"/></svg>
    </span>
    Compartir
  </summary>
  <div class="share-button__fallback">
    <div class="field">
      <input
        type="text"
        class="field__input"
        id="ShareUrl-{{ section.id }}"
        value="{{ share_permalink | default: product.url | prepend: request.origin }}"
        readonly
        onclick="this.select();"
      >
      <label class="field__label" for="ShareUrl-{{ section.id }}">Enlace</label>
    </div>
  </div>
</details>
