{% comment %}
  Botón de compartir profesional:
  - Móvil: usa la hoja de compartir nativa (navigator.share) → WhatsApp, Instagram, Mensajes, etc.
  - Escritorio / respaldo: botones directos (WhatsApp, Telegram, X, Facebook, Email) + copiar enlace.
  Accepts: share_title, share_permalink, share_image
{% endcomment %}
{%- assign it_share_url = share_permalink | default: product.url | prepend: request.origin -%}
{%- assign it_share_title = share_title | default: product.title -%}

<div class="it-share" data-url="{{ it_share_url }}" data-title="{{ it_share_title | escape }}">
  <div class="it-share__row">
    <button type="button" class="it-share__native" aria-label="Compartir">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>
      Compartir
    </button>

    <div class="it-share__icons">
      <a class="it-share__ic wa" data-net="wa" href="#" target="_blank" rel="noopener" aria-label="Compartir por WhatsApp">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.002-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/></svg>
      </a>
      <a class="it-share__ic tg" data-net="tg" href="#" target="_blank" rel="noopener" aria-label="Compartir por Telegram">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.91 3.79 20.3 20.84c-.25 1.21-.98 1.5-2 .94l-5.5-4.07-2.66 2.57c-.3.3-.55.56-1.1.56l.38-5.56 10.12-9.15c.44-.39-.1-.61-.68-.22L6.9 13.37l-5.45-1.7c-1.18-.37-1.2-1.18.26-1.75l21.3-8.22c.98-.36 1.84.22 1.53 1.71z"/></svg>
      </a>
      <a class="it-share__ic x" data-net="x" href="#" target="_blank" rel="noopener" aria-label="Compartir en X">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a class="it-share__ic fb" data-net="fb" href="#" target="_blank" rel="noopener" aria-label="Compartir en Facebook">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07"/></svg>
      </a>
      <a class="it-share__ic em" data-net="em" href="#" aria-label="Compartir por email">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
      </a>
      <button type="button" class="it-share__ic copy" aria-label="Copiar enlace">
        <svg class="ic-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        <svg class="ic-done" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
      </button>
    </div>
  </div>
  <span class="it-share__toast" aria-live="polite"></span>
</div>

<style>
.it-share{ margin-top:4px; }
.it-share__row{ display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
.it-share__native{
  display:inline-flex; align-items:center; gap:8px;
  height:42px; padding:0 18px;
  background:var(--it-surface,#fff); color:var(--it-text,#111);
  border:1px solid var(--it-border2,rgba(0,0,0,.16)); border-radius:10px;
  font-size:14px; font-weight:600; cursor:pointer;
  transition:border-color .18s, transform .15s, box-shadow .2s;
  -webkit-tap-highlight-color:transparent;
}
.it-share__native:hover{ border-color:var(--it-accent,#d4af37); transform:translateY(-1px); box-shadow:0 6px 16px rgba(0,0,0,.08); }
.it-share__native svg{ color:var(--it-accent,#d4af37); }
[data-theme="dark"] .it-share__native{ background:#17171a; color:#ede9e2; border-color:rgba(255,255,255,.14); }

.it-share__icons{ display:flex; align-items:center; gap:8px; }
.it-share__ic{
  display:inline-flex; align-items:center; justify-content:center;
  width:40px; height:40px; border-radius:50%;
  background:var(--it-surface2,#f3f3f4); color:var(--it-muted,#555);
  border:0.5px solid var(--it-border,rgba(0,0,0,.08));
  cursor:pointer; text-decoration:none;
  transition:transform .15s, background .2s, color .2s, box-shadow .2s;
  -webkit-tap-highlight-color:transparent;
}
.it-share__ic:hover{ transform:translateY(-2px); box-shadow:0 6px 14px rgba(0,0,0,.14); color:#fff; }
.it-share__ic.wa:hover{ background:#25d366; }
.it-share__ic.tg:hover{ background:#229ED9; }
.it-share__ic.x:hover{ background:#111; }
.it-share__ic.fb:hover{ background:#1877F2; }
.it-share__ic.em:hover{ background:#6b7280; }
.it-share__ic.copy:hover{ background:var(--it-accent,#d4af37); }
[data-theme="dark"] .it-share__ic{ background:rgba(255,255,255,.06); color:rgba(237,233,226,.7); border-color:rgba(255,255,255,.1); }
.it-share__ic.copy.done{ background:#16a34a; color:#fff; }

.it-share__toast{
  display:inline-block; margin-top:8px;
  font-size:12.5px; font-weight:600; color:#16a34a;
  opacity:0; transform:translateY(4px); transition:opacity .2s, transform .2s;
}
.it-share__toast.show{ opacity:1; transform:translateY(0); }
@media(max-width:480px){ .it-share__icons{ gap:6px } .it-share__ic{ width:38px; height:38px } }
</style>

<script>
(function(){
  var root = document.currentScript.previousElementSibling;
  while(root && !root.classList.contains('it-share')){ root = root.previousElementSibling; }
  if(!root) root = document.querySelector('.it-share');
  if(!root) return;

  var url = root.getAttribute('data-url');
  var title = root.getAttribute('data-title') || document.title;
  var eURL = encodeURIComponent(url);
  var eTXT = encodeURIComponent(title);
  var eBOTH = encodeURIComponent(title + ' ' + url);

  var links = {
    wa: 'https://wa.me/?text=' + eBOTH,
    tg: 'https://t.me/share/url?url=' + eURL + '&text=' + eTXT,
    x:  'https://twitter.com/intent/tweet?url=' + eURL + '&text=' + eTXT,
    fb: 'https://www.facebook.com/sharer/sharer.php?u=' + eURL,
    em: 'mailto:?subject=' + eTXT + '&body=' + eBOTH
  };
  root.querySelectorAll('.it-share__ic[data-net]').forEach(function(a){
    var net = a.getAttribute('data-net');
    if(links[net]) a.setAttribute('href', links[net]);
  });

  function toast(msg){
    var t = root.querySelector('.it-share__toast');
    if(!t) return;
    t.textContent = msg; t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 2200);
  }

  /* Botón principal → compartir nativo del móvil si está disponible */
  var native = root.querySelector('.it-share__native');
  if(native){
    native.addEventListener('click', function(){
      if(navigator.share){
        navigator.share({ title: title, url: url }).catch(function(){});
      } else {
        /* Escritorio sin share nativo → copiar enlace */
        copyLink();
      }
    });
  }

  /* Copiar enlace */
  function copyLink(){
    var done = function(){
      var c = root.querySelector('.it-share__ic.copy');
      if(c){ c.classList.add('done'); c.querySelector('.ic-copy').style.display='none'; c.querySelector('.ic-done').style.display='inline';
        setTimeout(function(){ c.classList.remove('done'); c.querySelector('.ic-copy').style.display='inline'; c.querySelector('.ic-done').style.display='none'; }, 2000); }
      toast('¡Enlace copiado!');
    };
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(url).then(done).catch(function(){ legacyCopy(); done(); });
    } else { legacyCopy(); done(); }
  }
  function legacyCopy(){
    var ta=document.createElement('textarea'); ta.value=url; ta.style.position='fixed'; ta.style.opacity='0';
    document.body.appendChild(ta); ta.select(); try{document.execCommand('copy');}catch(e){} document.body.removeChild(ta);
  }
  var copyBtn = root.querySelector('.it-share__ic.copy');
  if(copyBtn) copyBtn.addEventListener('click', copyLink);
})();
</script>
